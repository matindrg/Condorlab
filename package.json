{
  "name": "condorlab-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "کندرلب — پلتفرم سنجش تحلیلی المپیاد زیست‌شناسی ایران",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate && npm run build --workspace=@condorlab/database --workspace=@condorlab/shared",
    "predev": "npm run db:generate && npm run build --workspace=@condorlab/database --workspace=@condorlab/shared",
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev --workspace=@condorlab/web",
    "dev:api": "npm run dev --workspace=@condorlab/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@condorlab/web",
    "build:api": "npm run build --workspace=@condorlab/api",
    "db:generate": "npm run db:generate --workspace=@condorlab/database",
    "db:migrate": "npm run db:migrate --workspace=@condorlab/database",
    "db:push": "npm run db:push --workspace=@condorlab/database",
    "db:seed": "node scripts/seed.js",
    "db:studio": "npm run db:studio --workspace=@condorlab/database",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
