# ─── تنظیمات پایگاه داده PostgreSQL ───
POSTGRES_USER=condor_admin
POSTGRES_PASSWORD=condor_secret_1405
POSTGRES_DB=condorlab_db
DATABASE_URL=postgresql://condor_admin:condor_secret_1405@localhost:5432/condorlab_db?schema=public
DIRECT_URL=postgresql://condor_admin:condor_secret_1405@localhost:5432/condorlab_db?schema=public

# ─── تنظیمات Redis 7 (سشن‌لاک و هارت‌بیت) ───
REDIS_PASSWORD=condor_redis_secret
REDIS_URL=redis://:condor_redis_secret@localhost:6379

# ─── تنظیمات احراز هویت و توکن‌ها ───
JWT_SECRET=super_secret_condorlab_jwt_key_1405_phase_a
SESSION_COOKIE_NAME=condor_session

# ─── ذخیره‌سازی S3 / MinIO ───
MINIO_ROOT_USER=condor_s3_admin
MINIO_ROOT_PASSWORD=condor_s3_secret_1405
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_EXAMS=condorlab-exams
S3_BUCKET_RESOURCES=condorlab-resources

# ─── درگاه پرداخت زرین‌پال (Sandbox در فاز تست) ───
ZARINPAL_MERCHANT_ID=sandbox_merchant_id_test
ZARINPAL_SANDBOX=true

# ─── بات تلگرام ───
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXYZ
TELEGRAM_BOT_SECRET=condor_bot_internal_webhook_secret

# ─── ایمیل تراکنشی ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=auth@condorlab.ir
SMTP_PASS=example_smtp_password
